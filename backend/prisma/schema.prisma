generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  department   String    @default("Administration") // Sales | Factory | Accounting | Administration
  email        String    @unique
  passwordHash String
  role         String    @default("Worker") // Admin | Worker
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  progressEntries ProgressEntry[]
  stockChanges    StockChange[]
  attachments     Attachment[]
  purchaseOrders  PurchaseOrder[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  address   String   @db.Text
  email     String   @default("")
  telephone String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qts    QtReference[]
  orders ProductionOrder[]
}

model Product {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  price     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bom        ProductBom[]
  orderLines OrderLine[]
  qtLines    QtLine[]
}

model Material {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  unit      String   @default("pcs")
  minLevel  Decimal? @db.Decimal(14, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bom       ProductBom[]
  lots      MaterialLot[]
  changes   StockChange[]
  suppliers SupplierMaterial[]
  poLines   PurchaseOrderLine[]
}

model ProductBom {
  productId  Int
  materialId Int
  quantity   Decimal @db.Decimal(14, 3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@id([productId, materialId])
  @@index([materialId])
}

model MaterialLot {
  id         Int      @id @default(autoincrement())
  materialId Int
  lotNumber  String
  quantity   Decimal  @default(0) @db.Decimal(14, 3)
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, lotNumber])
}

model StockChange {
  id              Int      @id @default(autoincrement())
  materialId      Int
  lotNumber       String
  kind            String // Add | Deduct | Adjust
  change          Decimal  @db.Decimal(14, 3)
  balance         Decimal  @db.Decimal(14, 3)
  changeDate      DateTime @db.Date
  note            String   @db.Text
  initial         Boolean  @default(false)
  orderId         Int?
  purchaseOrderId Int?
  userId          Int
  at              DateTime @default(now())

  material      Material         @relation(fields: [materialId], references: [id], onDelete: Cascade)
  order         ProductionOrder? @relation(fields: [orderId], references: [id])
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  user          User             @relation(fields: [userId], references: [id])

  @@index([materialId])
  @@index([orderId])
  @@index([purchaseOrderId])
  @@index([userId])
}

model QtReference {
  id                Int       @id @default(autoincrement())
  qtNumber          String    @unique
  qtDate            DateTime  @db.Date
  customerId        Int
  notes             String    @db.Text
  customerPoNumber  String    @default("")
  customerPoDate    DateTime? @db.Date
  status            String    @default("Draft") // Draft | Confirmed
  productionOrderId Int?      @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer        Customer          @relation(fields: [customerId], references: [id])
  productionOrder ProductionOrder?  @relation("QtToOrder", fields: [productionOrderId], references: [id])
  lines           QtLine[]
  orders          ProductionOrder[] @relation("OrderOrigin")

  @@index([customerId])
}

model QtLine {
  id        Int @id @default(autoincrement())
  qtId      Int
  productId Int
  quantity  Int
  unitPrice Int

  qt      QtReference @relation(fields: [qtId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@unique([qtId, productId])
  @@index([productId])
}

model ProductionOrder {
  id          Int       @id @default(autoincrement())
  orderNumber String    @unique
  qtId        Int
  customerId  Int
  orderDate   DateTime  @db.Date
  notes       String    @db.Text
  startedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  qt           QtReference   @relation("OrderOrigin", fields: [qtId], references: [id])
  confirmedBy  QtReference?  @relation("QtToOrder")
  customer     Customer      @relation(fields: [customerId], references: [id])
  lines        OrderLine[]
  stockChanges StockChange[]
  invoice      Invoice?

  @@index([qtId])
  @@index([customerId])
}

model OrderLine {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Int

  order     ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  processes OrderProcess[]

  @@index([orderId])
  @@index([productId])
}

model OrderProcess {
  id                Int    @id @default(autoincrement())
  lineId            Int
  sequence          Int
  name              String
  instructions      String @db.Text
  status            String @default("Not Started") // Not Started | In Progress | Completed
  completedQuantity Int    @default(0)

  line     OrderLine       @relation(fields: [lineId], references: [id], onDelete: Cascade)
  progress ProgressEntry[]

  @@index([lineId])
}

model ProgressEntry {
  id                Int      @id @default(autoincrement())
  processId         Int
  status            String
  completedQuantity Int
  workDate          DateTime @db.Date
  note              String   @db.Text
  userId            Int
  at                DateTime @default(now())

  process OrderProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id])

  @@index([processId])
  @@index([userId])
}

model Invoice {
  id              Int      @id @default(autoincrement())
  invoiceNumber   String   @unique
  invoiceDate     DateTime @db.Date
  orderId         Int      @unique
  customerName    String
  customerAddress String   @db.Text
  total           Int
  status          String   @default("Unpaid") // Unpaid | Paid
  createdAt       DateTime @default(now())

  order   ProductionOrder @relation(fields: [orderId], references: [id])
  lines   InvoiceLine[]
  payment Payment?
  receipt Receipt?
}

model InvoiceLine {
  id          Int    @id @default(autoincrement())
  invoiceId   Int
  productCode String
  productName String
  quantity    Int
  unitPrice   Int
  amount      Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @unique
  paymentDate DateTime @db.Date
  amount      Int

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Receipt {
  id              Int      @id @default(autoincrement())
  receiptNumber   String   @unique
  invoiceId       Int      @unique
  receiptDate     DateTime @db.Date
  customerName    String
  customerAddress String   @db.Text
  amount          Int

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Attachment {
  id         Int      @id @default(autoincrement())
  ownerType  String // QtReference | ProductionOrder | PurchaseOrder
  ownerId    Int
  kind       String // PO_FILE | QUOTATION | EVIDENCE | OTHER
  fileName   String
  fileType   String
  size       Int
  filePath   String
  uploadedBy Int
  at         DateTime @default(now())

  user User @relation(fields: [uploadedBy], references: [id])

  @@index([ownerType, ownerId])
  @@index([uploadedBy])
}

model Supplier {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  contact   String   @default("")
  address   String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          SupplierMaterial[]
  purchaseOrders PurchaseOrder[]
}

model SupplierMaterial {
  supplierId Int
  materialId Int
  unitPrice  Int

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@id([supplierId, materialId])
  @@index([materialId])
}

model PurchaseOrder {
  id           Int       @id @default(autoincrement())
  poNumber     String    @unique
  supplierId   Int
  department   String
  requiredDate DateTime  @db.Date
  notes        String    @db.Text
  status       String    @default("Draft") // Draft | Sent | Received
  total        Int       @default(0)
  receivedAt   DateTime?
  createdBy    Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  creator      User                @relation(fields: [createdBy], references: [id])
  lines        PurchaseOrderLine[]
  payment      PurchasePayment?
  stockChanges StockChange[]

  @@index([supplierId])
  @@index([createdBy])
}

model PurchaseOrderLine {
  id         Int     @id @default(autoincrement())
  poId       Int
  materialId Int
  quantity   Decimal @db.Decimal(14, 3)
  unit       String
  unitPrice  Int
  amount     Int
  lotNumber  String?

  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  material Material      @relation(fields: [materialId], references: [id])

  @@index([poId])
  @@index([materialId])
}

model PurchasePayment {
  id          Int      @id @default(autoincrement())
  poId        Int      @unique
  paymentDate DateTime @db.Date
  amount      Int
  method      String
  referenceNo String   @default("")
  note        String   @db.Text

  po PurchaseOrder @relation(fields: [poId], references: [id])
}
